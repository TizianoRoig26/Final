# ==============================================================================
# TASTSERV — Variables de entorno para infraestructura n8n y PostgreSQL
# Copiar este archivo como .env dentro de infra/n8n/ y configurar valores
# ==============================================================================

# PostgreSQL (persistencia de escaneos de vulnerabilidades)
POSTGRES_DB=security_scans
POSTGRES_USER=n8n_user
POSTGRES_PASSWORD=tu_contraseña_segura_aqui
POSTGRES_PORT=5433

# n8n (orquestador de flujos)
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=false
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=tu_contraseña_n8n
GENERIC_TIMEZONE=America/Argentina/Mendoza
TZ=America/Argentina/Mendoza

# GMP / Greenbone (usado por automated_scan.sh / automated_scan.gmp.py)
GMP_ADMIN_USER=admin
GMP_ADMIN_PASSWORD=tu_contraseña_gmp

# Mailtrap / SMTP (notificaciones por correo)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=tu_mailtrap_user
MAILTRAP_PASSWORD=tu_mailtrap_password

