# ==============================================================================
# TASTSERV — Variables de entorno del proyecto
# Copiar este archivo como .env y completar con valores reales
# ==============================================================================

# n8n (orquestador)
N8N_BASIC_AUTH_USER=<REDACTADO>
N8N_BASIC_AUTH_PASSWORD=<REDACTADO>

# GMP (Greenbone Management Protocol)
GMP_ADMIN_USER=admin
GMP_ADMIN_PASSWORD=<REDACTADO>

# PostgreSQL (persistencia de resultados)
POSTGRES_USER=<REDACTADO>
POSTGRES_PASSWORD=<REDACTADO>
POSTGRES_DB=<REDACTADO>

# Mailtrap (SMTP sandbox para notificaciones)
MAILTRAP_USER=<REDACTADO>
MAILTRAP_PASSWORD=<REDACTADO>
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525

# n8n Encryption Key (para almacén de credenciales)
N8N_ENCRYPTION_KEY=<REDACTADO>
